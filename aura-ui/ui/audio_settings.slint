import { Style } from "style.slint";
import { Z_IconButton } from "./primitives/icon_button.slint";
import { AudioSettingsActions } from "./actions/audio_settings_actions.slint";

export component Z_AudioSettings inherits Rectangle {
    in property <bool> ready: false;
    in property <string> device-catalog: "[]";
    in property <[string]> device-names: [];
    in property <float> sample-rate: 0.0;
    in property <int> buffer-size: 0;
    in property <int> dropped-blocks: 0;
    in property <string> diagnostic: "";
    in property <bool> busy: false;
    background: Style.surface-1; border-width: 1px; border-color: Style.line-subtle;
    HorizontalLayout {
        padding: 18px; spacing: 18px;
        Rectangle {
            width: 196px; background: Style.surface-0; border_width: 1px; border_color: Style.border; border_radius: 8px;
            VerticalLayout {
                padding: 14px; spacing: 6px;
                Text { text: "Aura"; font-size: 20px; color: Style.text-primary; font-weight: 700; }
                Text { text: "Settings"; font-size: 10px; color: Style.text-tertiary; }
                Rectangle { height: 16px; }
                for item[idx] in ["General", "Audio", "MIDI", "Plugins", "Appearance", "Shortcuts", "Project"] : Rectangle {
                    height: 34px; border_radius: 5px; background: item == "Audio" ? Style.selection : transparent;
                    Text { text: ["⚙", "◖", "⌁", "▦", "◐", "⌨", "▣"][idx]; x: 12px; font-size: 12px; color: item == "Audio" ? Style.brand : Style.text-tertiary; vertical-alignment: center; }
                    Text { text: item; x: 36px; font-size: 10px; color: item == "Audio" ? Style.text-primary : Style.text-dim; vertical-alignment: center; }
                }
                Rectangle { vertical-stretch: 1; }
                Text { text: "Aura Studio"; font-size: 10px; color: Style.text-tertiary; }
                Text { text: "Audio engine settings"; font-size: 9px; color: Style.text-muted; }
            }
        }
        VerticalLayout {
            spacing: 12px;
            HorizontalLayout { height: 44px; Text { text: "Audio"; font-size: 24px; color: Style.text-primary; font-weight: 700; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } Rectangle { width: 220px; height: 30px; background: Style.surface-0; border_width: 1px; border_color: Style.border; border_radius: 5px; Text { text: "⌕  Search settings"; x: 10px; width: parent.width - 20px; color: Style.text-tertiary; font-size: 10px; vertical-alignment: center; } } Text { text: root.ready ? "● Device connected" : "● Device offline"; font-size: 10px; color: root.ready ? Style.ok : Style.record; vertical-alignment: center; } }
            Text { text: "Configure the audio device, sample rate and realtime buffer used by the engine."; font-size: 10px; color: Style.text-secondary; }
            HorizontalLayout {
                spacing: 12px; vertical-stretch: 1;
                Rectangle { horizontal-stretch: 1; background: Style.surface; border_width: 1px; border_color: Style.border; border_radius: 8px; VerticalLayout { padding: 14px; spacing: 10px;
                    Text { text: "Audio device"; font-size: 15px; color: Style.text-primary; font-weight: 650; }
                    Text { text: root.dropped-blocks > 0 ? "Input drops: " + root.dropped-blocks : "Input stream stable"; font-size: 10px; color: root.dropped-blocks > 0 ? Style.record : Style.ok; }
                    Text { text: "Available devices"; font-size: 10px; color: Style.text-tertiary; }
                    for device[idx] in root.device-names : Z_IconButton { icon: device; compact: false; enabled: !root.busy; button-width: 220px; clicked => { AudioSettingsActions.select_device(idx); } }
                    Text { text: "Devices: " + root.device-catalog; font-size: 9px; color: Style.text-muted; overflow: elide; }
                    Rectangle { vertical-stretch: 1; }
                    Z_IconButton { icon: "Reconnect audio"; button-width: 150px; active-col: Style.record; clicked => { AudioSettingsActions.reconnect(); } }
                } }
                Rectangle { horizontal-stretch: 1; background: Style.surface; border_width: 1px; border_color: Style.border; border_radius: 8px; VerticalLayout { padding: 14px; spacing: 10px;
                    Text { text: "Realtime performance"; font-size: 15px; color: Style.text-primary; font-weight: 650; }
                    Text { text: root.busy ? "Stop playback or recording before changing format." : "Changes apply when the transport is stopped."; font-size: 10px; color: root.busy ? Style.record : Style.text-secondary; }
                    Text { text: "Sample rate"; font-size: 10px; color: Style.text-tertiary; }
                    HorizontalLayout { spacing: 5px; for rate in ["44.1 kHz", "48 kHz", "88.2 kHz", "96 kHz"] : Z_IconButton { icon: rate; compact: true; enabled: !root.busy; button-width: 76px; clicked => { AudioSettingsActions.apply_config(rate == "44.1 kHz" ? 44100 : (rate == "48 kHz" ? 48000 : (rate == "88.2 kHz" ? 88200 : 96000)), root.buffer-size > 0 ? root.buffer-size : 256); } } }
                    Text { text: "Buffer size"; font-size: 10px; color: Style.text-tertiary; }
                    HorizontalLayout { spacing: 5px; for size in [32, 64, 128, 256, 512] : Z_IconButton { icon: size + " samples"; compact: true; enabled: !root.busy; button-width: 78px; clicked => { AudioSettingsActions.apply_config(root.sample-rate > 0 ? Math.round(root.sample-rate) : 48000, size); } } }
                    Rectangle { height: 1px; background: Style.border; }
                    Text { text: "Current  " + (root.sample-rate > 0 ? Math.round(root.sample-rate) + " Hz" : "--") + "  ·  " + (root.buffer-size > 0 ? root.buffer-size + " samples" : "--"); font-size: 11px; color: Style.brand; }
                    Text { text: root.diagnostic; font-size: 9px; color: Style.text-tertiary; overflow: elide; }
                } }
            }
        }
    }
}
