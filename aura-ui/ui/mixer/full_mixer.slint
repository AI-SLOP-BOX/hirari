import { ScrollView } from "std-widgets.slint";
import { Style } from "../style.slint";
import { Z_IconButton } from "../primitives/icon_button.slint";
import { Z_MixerStrip } from "./mixer_strip.slint";
import { Z_Track } from "../model/track_model.slint";
import { MixerActions } from "../actions/mixer_actions.slint";

export component Z_FullMixer {
    in property <[Z_Track]> tracks;
    in property <[float]> pks;
    in property <[float]> pks_h;
    in property <int> meter_mode;
    callback close();
    VerticalLayout {
        padding: 12px; spacing: 16px;
        Rectangle {
            height: 32px; background: Style.surface; border_radius: 2px;
            HorizontalLayout {
                padding: 6px; spacing: 12px;
                Text { text: "Mixer"; font-size: 11px; color: Style.brand; font-weight: 950; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Z_IconButton { icon: "✕"; clicked => { close(); } }
            }
        }
        ScrollView {
            horizontal-stretch: 1; vertical-stretch: 1;
            HorizontalLayout {
                spacing: 2px; padding: 4px;
                for trk[idx] in tracks : Z_MixerStrip {
                    property <float> safe_peak: pks.length > idx + 1 ? pks[idx + 1] : 0.0;
                    property <float> safe_hold: pks_h.length > idx + 1 ? pks_h[idx + 1] : 0.0;
                    name: trk.name; color: trk.color; volume: trk.volume; pan: trk.pan;
                    peak: safe_peak; pk_h: safe_hold; tid: trk.id;
                    is_mute: trk.mute; is_solo: trk.solo; is_phase: trk.phase_invert;
                    fx: trk.fx; compact: false; send_lvl: trk.send_lvl;
                    filter_lp: trk.filter_lp; filter_hp: trk.filter_hp; track_idx: idx;
                    meter_mode: meter_mode; group_id: trk.group_id;
                    saturate_active: trk.saturate_active; correlation: trk.correlation;
                    low_b: trk.eq_low_band; low_c: trk.eq_low_cut; high_b: trk.eq_high_band; high_c: trk.eq_high_cut;
                    fader-changed(a, b) => { MixerActions.fader_changed(a, b); }
                    pan-changed(a, b) => { MixerActions.pan_changed(a, b); }
                    mute-toggled(a) => { MixerActions.toggle_mute(a); }
                    solo-toggled(a) => { MixerActions.toggle_solo(a); }
                    phase-toggled(a) => { MixerActions.toggle_phase(a); }
                    fx-toggled(a, b) => { MixerActions.toggle_fx(a, b); }
                    delay-changed(a, b) => { MixerActions.delay_changed(a, b); }
                    eq-changed(a, b, c, d, e) => { MixerActions.eq_changed(a, b, c, d, e); }
                    peaks-reset => { MixerActions.reset_peaks(); }
                }
            }
        }
    }
}
