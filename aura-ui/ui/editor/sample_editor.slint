import { Style } from "../style.slint";
import { Z_IconButton } from "../primitives/icon_button.slint";

export component Z_SampleEditor {
    callback apply-gain(float);
    callback apply-fades(float, float);
    callback apply-reverse(bool);
    callback apply-trim(float, float);
    callback apply-warp(float);
    callback apply-pitch(float);
    callback apply-loop(int);
    callback repair-waveform();
    callback declip-waveform();
    callback reduce-noise-waveform();
    callback normalize-waveform();
    callback soft-clip-waveform();
    callback declick-waveform();
    callback stereo-width-waveform();
    callback detect-transients-waveform();
    callback mute-selection();
    callback normalize-selection-peak();
    callback normalize-selection-rms();
    callback duplicate-clip();
    callback remove-clip();
    in property <float> initial-trim-start: 0.0;
    in property <float> initial-trim-end: 1.0;
    in-out property <[float]> samples;
    in-out property <color> wave_col: Style.brand;
    
    // Interactive states
    in-out property <float> trim_start: initial-trim-start; // normalized 0.0 - 1.0
    in-out property <float> trim_end: initial-trim-end;   // normalized 0.0 - 1.0
    in-out property <float> scale_multiplier: 1.0; // modified by Normalize
    in-out property <bool> is_reversed: false;
    in-out property <bool> is_faded: false;
    in-out property <bool> flex_mode: false;
    in-out property <float> flex_ratio: 1.0;
    in-out property <float> pitch_semitones: 0.0;
    in-out property <int> loop_count: 1;
    in-out property <float> editor_ph: 0.4; // simulated playhead position
    in property <image> gpu-waveform-image;
    in property <image> gpu-spectrum-image;

    Rectangle {
        background: Style.surface; border_width: 1.5px; border_color: Style.border;
        HorizontalLayout {
            spacing: 8px;
            // Clip/take browser mirrors the reference editor's left rail.
            Rectangle { width: 184px; background: Style.surface-1; border_width: 1px; border_color: Style.border; border_radius: 5px;
                VerticalLayout { spacing: 0px;
                    Rectangle { height: 38px; background: Style.surface-2; HorizontalLayout { padding: 10px; Text { text: "Clips"; color: Style.text-primary; font-size: 11px; font-weight: 700; } Rectangle { horizontal-stretch: 1; } Text { text: "Takes"; color: Style.text-tertiary; font-size: 9px; } } }
                    Rectangle { height: 34px; x: 8px; width: parent.width - 16px; background: Style.surface-0; border_width: 1px; border_color: Style.border; border_radius: 4px; Text { text: "Search clips, takes..."; x: 8px; color: Style.text-tertiary; font-size: 9px; vertical-alignment: center; } }
                    for clip[idx] in ["Vocal_Main_01", "Vocal_Main_02", "Vocal_Harmony", "Guitar_Acoustic", "Guitar_Solo", "Vocal_Double", "Room_Take"] : Rectangle { height: 48px; x: 8px; width: parent.width - 16px; background: idx == 0 ? Style.selection : transparent; border_radius: 4px; HorizontalLayout { padding: 6px; spacing: 7px; Rectangle { width: 34px; height: 30px; background: [Style.brand, #4C8DFF, #3BC6C8, #D39A3A, #56C88A, #A76CFF, #718093][idx]; border_radius: 3px; } VerticalLayout { alignment: center; Text { text: clip; color: Style.text-primary; font-size: 9px; } Text { text: Math.mod(idx, 2) == 0 ? "Vocals  ·  4:12" : "Audio  ·  2:36"; color: Style.text-tertiary; font-size: 8px; } } } }
                    Rectangle { vertical-stretch: 1; }
                }
            }
            VerticalLayout {
            horizontal-stretch: 1;
            padding: 12px; spacing: 10px;
            
            // Header controls
            HorizontalLayout {
                spacing: 12px;
                Text { text: "Waveform Editor"; font-size: 14px; color: Style.text-primary; font-weight: 700; vertical-alignment: center; }
                for tab in ["Waveform", "Pitch", "Warp", "Gain"] : Rectangle {
                    width: 58px; height: 24px; border_radius: 4px;
                    background: tab == "Waveform" ? Style.brand-glow : transparent;
                    Text { text: tab; font-size: 9px; color: tab == "Waveform" ? Style.brand : Style.text-dim; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle { horizontal-stretch: 1; }
                
                Z_IconButton { 
                    icon: "NORMALIZE"; 
                    active: scale_multiplier > 1.0;
                    clicked => {
                        scale_multiplier = scale_multiplier == 1.0 ? 1.4 : 1.0;
                        root.apply-gain(scale_multiplier);
                    }
                }
                Z_IconButton { 
                    icon: "REVERSE"; 
                    active: is_reversed;
                    clicked => {
                        is_reversed = !is_reversed;
                        root.apply-reverse(is_reversed);
                    }
                }
                Z_IconButton { 
                    icon: "FADE IN/OUT"; 
                    active: is_faded;
                    clicked => {
                        is_faded = !is_faded;
                        root.apply-fades(is_faded ? 0.05 : -0.05, is_faded ? 0.05 : -0.05);
                    }
                }
                Z_IconButton { icon: "FLEX"; active: flex_mode; clicked => { flex_mode = !flex_mode; flex_ratio = flex_mode ? 1.1 : 1.0; root.apply-warp(flex_ratio); } }
                Z_IconButton { icon: "PITCH"; active: pitch_semitones != 0.0; clicked => { pitch_semitones = pitch_semitones == 0.0 ? 1.0 : 0.0; root.apply-pitch(pitch_semitones); } }
                Z_IconButton { icon: "LOOP"; active: loop_count > 1; clicked => { loop_count = loop_count == 1 ? 2 : (loop_count == 2 ? 4 : 1); root.apply-loop(loop_count); } }
                Z_IconButton { icon: "REPAIR"; clicked => { root.repair-waveform(); } }
                Z_IconButton { icon: "DECLIP"; clicked => { root.declip-waveform(); } }
                Z_IconButton { icon: "DENOISE"; clicked => { root.reduce-noise-waveform(); } }
                Z_IconButton { icon: "MASTER"; clicked => { root.normalize-waveform(); root.soft-clip-waveform(); } }
                Z_IconButton { icon: "DECLICK"; clicked => { root.declick-waveform(); } }
                Z_IconButton { icon: "STEREO"; clicked => { root.stereo-width-waveform(); } }
                Z_IconButton { icon: "TRANSIENT"; clicked => { root.detect-transients-waveform(); } }
                Z_IconButton { icon: "MUTE SEL"; clicked => { root.mute-selection(); } }
                Z_IconButton { icon: "PEAK SEL"; clicked => { root.normalize-selection-peak(); } }
                Z_IconButton { icon: "RMS SEL"; clicked => { root.normalize-selection-rms(); } }
                Z_IconButton { icon: "DUPLICATE"; clicked => { root.duplicate-clip(); } }
                Z_IconButton { icon: "DELETE CLIP"; clicked => { root.remove-clip(); } }
                Z_IconButton { 
                    icon: "RESET TRIM"; 
                    clicked => {
                        trim_start = 0.0;
                        trim_end = 1.0;
                        root.apply-trim(trim_start, trim_end);
                    }
                }
            }
            Text { text: "Gain, fades, trim, reverse, Flex, pitch and loop count are saved with the project"; font-size: Style.font-xxs; color: Style.text-muted; }
            
            // Waveform Canvas
            Rectangle {
                background: #020202; border_width: 1px; border_color: Style.surface; height: 180px; clip: true;

                if (gpu-waveform-image.width > 0) : Image {
                    source: gpu-waveform-image; x: 10px; y: 10px;
                    width: parent.width - 20px; height: parent.height - 20px;
                    image-fit: fill; opacity: 0.92;
                }
                
                // Trim region selection background shading
                Rectangle {
                    x: trim_start * parent.width;
                    width: (trim_end - trim_start) * parent.width;
                    height: 100%;
                    background: Style.brand.with-alpha(0.05);
                }
                
                // Bipolar Waveform rendering
                if (gpu-waveform-image.width <= 0) : HorizontalLayout {
                    spacing: 2px; padding-left: 10px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px;
                    for s[idx] in samples : VerticalLayout {
                        alignment: center;
                        
                        // Calculate sample values taking into account reverse and fade effects
                        property <int> mapped_idx: is_reversed ? (samples.length - 1 - idx) : idx;
                        property <float> base_val: samples[mapped_idx];
                        
                        // Apply fade curve
                        property <float> fade_factor: is_faded ? (
                            idx < 5 ? (idx / 5.0) : 
                            (idx > (samples.length - 6) ? ((samples.length - 1 - idx) / 5.0) : 1.0)
                        ) : 1.0;
                        
                        property <float> final_h: (base_val * scale_multiplier * fade_factor).clamp(0.0, 1.0);
                        
                        // Check if outside trim boundaries
                        property <float> norm_pos: idx / samples.length;
                        property <bool> is_trimmed: (norm_pos < trim_start || norm_pos > trim_end);

                        Rectangle {
                            width: 3px; height: final_h * 140.0 * 1px; 
                            background: is_trimmed ? #333 : wave_col; 
                            border_radius: 1.5px; 
                            opacity: is_trimmed ? 0.3 : 0.9;
                            animate height { duration: 150ms; }
                            animate background { duration: 150ms; }
                        }
                    }
                }
                
                // Center line
                Rectangle { height: 1px; background: Style.border; width: 100%; y: parent.height / 2; opacity: 0.3; }
                
                // Playhead
                Rectangle {
                    x: editor_ph * parent.width;
                    width: 2px; height: 100%; background: Style.ok;
                    animate x { duration: 100ms; }
                }
                if (flex_mode) : Rectangle {
                    width: 100%; height: 100%;
                    for t in [0.18, 0.37, 0.59, 0.78] : Rectangle {
                        x: t * parent.width; y: 18px; width: 1px; height: parent.height - 36px; background: Style.cycle; opacity: 0.8;
                        Rectangle { x: -3px; y: -4px; width: 7px; height: 7px; border-radius: 4px; background: Style.cycle; }
                    }
                    Text { text: "Flex Time / Pitch"; x: 8px; y: 8px; font-size: Style.font-xxs; color: Style.cycle; }
                }
                
                // Draggable Trim Handles
                // Start Bracket handle
                Rectangle {
                    x: trim_start * parent.width - 4px; width: 8px; height: 100%;
                    background: transparent;
                    Rectangle { width: 2px; height: 100%; background: Style.alert; x: 3px; }
                    // Handle tab
                    Rectangle { width: 8px; height: 20px; background: Style.alert; border_radius: 2px; y: 80px; }
                    TouchArea {
                        moved => {
                            if (self.pressed) {
                                trim_start = (trim_start + (self.mouse_x - self.pressed_x) / parent.width).clamp(0.0, trim_end - 0.1);
                                root.apply-trim(trim_start, trim_end);
                            }
                        }
                    }
                }
                // End Bracket handle
                Rectangle {
                    x: trim_end * parent.width - 4px; width: 8px; height: 100%;
                    background: transparent;
                    Rectangle { width: 2px; height: 100%; background: Style.alert; x: 3px; }
                    // Handle tab
                    Rectangle { width: 8px; height: 20px; background: Style.alert; border_radius: 2px; y: 80px; }
                    TouchArea {
                        moved => {
                            if (self.pressed) {
                                trim_end = (trim_end + (self.mouse_x - self.pressed_x) / parent.width).clamp(trim_start + 0.1, 1.0);
                                root.apply-trim(trim_start, trim_end);
                            }
                        }
                    }
                }
                
                // Scrub Touch Area
                TouchArea {
                    clicked => {
                        editor_ph = (self.mouse_x / parent.width).clamp(0.0, 1.0);
                    }
                }
            }

            if (gpu-spectrum-image.width > 0) : Rectangle {
                height: 54px; background: #050812; border_width: 1px; border_color: Style.border;
                Image { source: gpu-spectrum-image; x: 8px; y: 4px; width: parent.width - 16px; height: parent.height - 8px; image-fit: fill; }
                Text { text: "GPU SPECTRUM"; x: 12px; y: 6px; font-size: 8px; color: Style.text-tertiary; }
            }
            
            // Time Ruler labels
            HorizontalLayout {
                Text { text: "Start: " + Math.floor(trim_start * 165) + ".0 ms"; font-size: Style.font-xxs; color: Style.text-tertiary; font-weight: 500; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: "Active: " + Math.floor((trim_end - trim_start) * 165) + ".0 ms"; font-size: Style.font-xxs; color: Style.brand; font-weight: 600; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: "End: " + Math.floor(trim_end * 165) + ".0 ms"; font-size: Style.font-xxs; color: Style.text-tertiary; font-weight: 500; }
            }
            }
            // Context inspector mirrors Clip / Regions / Markers in the reference.
            Rectangle { width: 220px; background: Style.surface-1; border_width: 1px; border_color: Style.border; border_radius: 5px;
                VerticalLayout { spacing: 0px;
                    Rectangle { height: 38px; background: Style.surface-2; HorizontalLayout { padding: 10px; Text { text: "Clip"; color: Style.text-primary; font-size: 11px; font-weight: 700; } Rectangle { horizontal-stretch: 1; } Text { text: "Regions"; color: Style.text-tertiary; font-size: 9px; } Text { text: "Markers"; color: Style.text-tertiary; font-size: 9px; } } }
                    VerticalLayout { padding: 12px; spacing: 9px; Text { text: "Vocal_Main_01"; color: Style.text-primary; font-size: 13px; font-weight: 700; } Text { text: "Audio Clip"; color: Style.text-tertiary; font-size: 9px; } Text { text: "START"; color: Style.text-tertiary; font-size: 8px; } Rectangle { height: 26px; background: Style.panel; border_radius: 4px; Text { text: "17.1.1"; x: 9px; color: Style.text-secondary; font-size: 9px; vertical-alignment: center; } } Text { text: "END"; color: Style.text-tertiary; font-size: 8px; } Rectangle { height: 26px; background: Style.panel; border_radius: 4px; Text { text: "20.1.1"; x: 9px; color: Style.text-secondary; font-size: 9px; vertical-alignment: center; } } Text { text: "Pitch Shift"; color: Style.text-tertiary; font-size: 8px; } Rectangle { height: 26px; background: Style.panel; border_radius: 4px; Text { text: "0 st"; x: 9px; color: Style.text-secondary; font-size: 9px; vertical-alignment: center; } } Text { text: "Warp Mode  ·  Pro (Universal)"; color: Style.text-secondary; font-size: 9px; } Text { text: "Gain  +0.0 dB"; color: Style.text-secondary; font-size: 9px; } Rectangle { vertical-stretch: 1; } Text { text: "Preserve Formants     ●"; color: Style.ok; font-size: 9px; } Text { text: "Source: Recording"; color: Style.text-tertiary; font-size: 8px; } }
                }
            }
        }
    }
}
