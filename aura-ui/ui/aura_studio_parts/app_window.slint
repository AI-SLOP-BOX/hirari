// Stable view identifiers shared by menus, bottom navigation, and rendered
// panels. Keep numeric values compatible with the Rust bridge.
export global ViewModes {
    in property<int> mixer: 0;
    in property<int> audio_editor: 1;
    in property<int> piano_roll: 2;
    in property<int> console: 9;
    in property<int> smart_controls: 10;
    in property<int> loops: 11;
    in property<int> drums: 12;
    in property<int> automation: 13;
    in property<int> project: 14;
    in property<int> setup: 15;
    in property<int> browser: 16;
    in property<int> midi: 17;
    in property<int> export: 18;
    in property<int> diagnostics: 19;
    in property<int> preferences: 20;
    in property<int> flex: 21;
    in property<int> comp: 22;
    in property<int> stacks: 23;
    in property<int> global: 24;
    in property<int> steps: 25;
    in property<int> openutau: 26;
}
import { Z_WorkflowPage, Z_StepSequencerPage, Z_TrackStackPage } from "./pages/workflow_pages.slint";
