import { Style } from "../style.slint";
import { Button } from "std-widgets.slint";

export component Z_IconButton {
    in property <string> icon;
    in property <bool> active: false;
    in property <bool> selected: false;
    in property <bool> compact: false;
    in property <bool> enabled: true;
    in property <length> button-width: compact ? 24px : 60px;
    in property <color> active-col: Style.brand;
    callback clicked();
    Rectangle {
        height: 24px; width: root.button-width; border-radius: compact ? 12px : 3px;
        background: !root.enabled ? Style.surface-1 : (area.pressed ? Style.surface-0 : (root.selected ? Style.selection : (root.active ? Style.surface-3 : (area.has-hover ? Style.panel-h : Style.panel))));
        border-width: semantic.has-focus ? 2px : 1px;
        border-color: semantic.has-focus ? Style.brand : (!root.enabled ? Style.surface-0 : ((root.active || root.selected) ? active-col : Style.border));
        opacity: root.enabled ? 1.0 : 0.48;
        animate background { duration: 100ms; }
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: 1px;
            background: Style.bezel-light.with-alpha(area.has-hover || root.active || root.selected ? 0.35 : 0.16);
        }
        if (root.active || root.selected) : Rectangle { x: 2px; y: parent.height - 3px; width: parent.width - 4px; height: 2px; background: active-col; }
        area := TouchArea {
            // The transparent standard Button below owns the accessibility
            // action. Keeping this raw pointer area non-accessible avoids a
            // duplicate control in VoiceOver/Computer Use trees.
            accessible-role: none;
            mouse-cursor: root.enabled ? pointer : default;
            clicked => { if (root.enabled) { root.clicked(); } }
        }
        // Slint's standard Button is used as an invisible interaction layer
        // so macOS exposes a real button rather than the icon Text item. The
        // visual skin above remains Aura-specific; the native semantic layer
        // is intentionally transparent to users.
        semantic := Button {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            text: root.icon;
            enabled: root.enabled;
            opacity: 0.01;
            clicked => { root.clicked(); }
        }
        Text {
            text: icon; font-family: Style.ui-font; font-size: Style.font-xs;
            font-weight: 500; color: root.active || root.selected ? Style.text-primary : (area.has-hover ? Style.text : Style.text-dim);
            vertical-alignment: center; horizontal-alignment: center; overflow: elide;
        }
    }
}
