import { Style } from "style.slint";

export component Z_IndustrialKnob {
    in-out property <float> value: 0.5;
    in property <string> label: "GAIN";
    callback changed(float);
    VerticalLayout {
        spacing: 2px;
        Rectangle {
            width: 32px; height: 32px; border_radius: 16px; background: Style.surface-0; border_width: 1px; border_color: Style.line-subtle;
            Path {
                width: 100%; height: 100%; stroke: Style.brand; stroke-width: 2px;
                viewbox-width: 100; viewbox-height: 100;
                // [Knob Arc rendering based on value]
            }
            Rectangle {
                width: 2px; height: 8px; background: Style.text-primary; x: parent.width/2 - 1px; y: 4px;
                transform: rotate(value * 270deg - 135deg);
            }
            TouchArea {
                mouse-cursor: ns-resize;
                moved => {
                    if (self.pressed) {
                        root.value = (root.value + ((self.pressed_y - self.mouse_y) / 100.0) / 1px).clamp(0, 1);
                        root.changed(root.value);
                    }
                }
            }
        }
        Text { text: label; font-size: Style.font-xxs; color: Style.text-tertiary; horizontal-alignment: center; }
        Text { text: Math.round(value * 100.0) + "%"; font-size: Style.font-xxs; color: Style.text-secondary; font-family: Style.numeric-font; horizontal-alignment: center; }
    }
}

export component Z_ProSlot {
    in property <string> pluginName: "EMPTY";
    in property <bool> isActive: false;
    in property <bool> bypassed: false;
    callback clicked();
    Rectangle {
        height: 18px; background: !isActive ? Style.surface-0 : (bypassed ? Style.surface-1 : Style.surface-2); border_width: 1px; border_color: isActive ? Style.brand.with-alpha(0.45) : Style.line-subtle;
        Text { text: pluginName; font-size: Style.font-xxs; color: !isActive ? Style.text-tertiary : (bypassed ? Style.text-muted : Style.text-primary); x: 4px; vertical-alignment: center; }
        if (isActive) : Rectangle { x: 1px; y: 1px; width: 2px; height: parent.height - 2px; background: bypassed ? Style.text-muted : Style.ok; }
        TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    }
}

export component Z_ProMenu {
    in property <[string]> items;
    in-out property <int> selected-index: -1;
    callback selected(int);
    Rectangle {
        width: 120px; background: Style.surface-1; border_width: 1px; border_color: Style.line-strong;
        VerticalLayout {
            for item[idx] in items : Rectangle {
                height: 20px;
                background: selected-index == idx ? Style.selection : (area.has-hover ? Style.surface-3 : transparent);
                Text { text: item; font-size: Style.font-xs; color: selected-index == idx ? Style.text-primary : Style.text-secondary; x: 8px; vertical-alignment: center; }
                area := TouchArea { mouse-cursor: pointer; clicked => { root.selected-index = idx; root.selected(idx); } }
            }
        }
    }
}

export component SpectralRestorationHUD {
    in property <float> denoise_threshold: 0.5;
    in property <bool> learn_mode: false;
    
    Rectangle {
        background: Style.surface-0; border_radius: 4px; border_width: 1px; border_color: Style.line-subtle;
        padding: 8px;
        
        VerticalLayout {
            spacing: 8px;
            Text { text: "SPECTRAL SURGERY"; font-size: 10px; font-weight: 700; color: Style.brand; letter-spacing: 1px; }
            
            HorizontalLayout {
                spacing: 12px;
                Z_IndustrialKnob { label: "THRESHOLD"; value: denoise_threshold; }
                
                VerticalLayout {
                    spacing: 4px;
                    Rectangle {
                        width: 60px; height: 16px; background: learn_mode ? Style.record.with-alpha(0.22) : Style.surface-0; border_radius: 2px;
                        Text { text: "Learn"; font-size: Style.font-xxs; color: learn_mode ? Style.record : Style.text-tertiary; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: 60px; height: 16px; background: Style.surface-0; border_radius: 2px;
                        Text { text: "Erase Harmonics"; font-size: Style.font-xxs; color: Style.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
            
            // Optional visualizer surface
            Rectangle {
                height: 40px; background: Style.lcd-bg; border_width: 1px; border_color: Style.surface-0;
                for i in 20 : Rectangle {
                    x: i * (parent.width / 20) + 1px;
                    y: parent.height - (parent.height * 0.5 * (1.0 + Math.sin(i * 0.5)));
                    width: 2px; height: 2px; background: Style.brand; opacity: 0.5;
                }
            }
        }
    }
}
export component MasterMasteringHUD {
    in property <float> lufs: -14.0;
    in property <float> peakL: -0.1;
    in property <float> peakR: -0.1;
    in property <float> cpu_load: 0.15;

    Rectangle {
        background: Style.surface-1; border_radius: 2px; border_width: 1px; border_color: Style.line-subtle;
        padding: 6px;
        width: 180px;

        VerticalLayout {
            spacing: 4px;
            Text { text: "Mastering Telemetry"; font-size: Style.font-xxs; font-weight: 600; color: Style.text-tertiary; letter-spacing: 0.5px; }

            HorizontalLayout {
                spacing: 8px;
                // LUFS Meter
                VerticalLayout {
                    width: 40px;
                    Text { text: @tr("{lufs} LUFS", lufs = Math.round(lufs)); font-size: 10px; color: Style.brand; }
                    Rectangle { height: 4px; background: Style.surface-0; Rectangle { width: Math.clamp((lufs + 30.0)/30.0, 0, 1) * 100%; background: Style.brand; } }
                }

                // Peak Meter
                VerticalLayout {
                    spacing: 2px;
                    Rectangle { width: 80px; height: 3px; background: Style.surface-0; Rectangle { width: Math.clamp(peakL + 1.0, 0, 1) * 100%; background: peakL > 0.0 ? Style.record : Style.ok; } }
                    Rectangle { width: 80px; height: 3px; background: Style.surface-0; Rectangle { width: Math.clamp(peakR + 1.0, 0, 1) * 100%; background: peakR > 0.0 ? Style.record : Style.ok; } }
                }

                // CPU
                VerticalLayout {
                    Text { text: @tr("{load}% CPU", load = Math.round(cpu_load * 100)); font-size: Style.font-xxs; color: Style.text-secondary; horizontal-alignment: right; }
                }
            }
        }
    }
}
