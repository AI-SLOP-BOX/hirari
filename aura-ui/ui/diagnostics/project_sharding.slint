import { Style } from "../style.slint";

export component Z_ProjectSharding {
    in property <float> cluster_health: 0.98;
    Rectangle {
        width: 100%; height: 280px; background: Style.surface; border_width: 1px; border_color: Style.brand;
        VerticalLayout {
            padding: 16px; spacing: 14px;
            Text { text: "Project Sharding"; font-size: 11px; color: Style.brand; font-weight: 700; }
            HorizontalLayout {
                spacing: 20px;
                for node_id in 4 : VerticalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 80px; height: 100px; background: #000; border_radius: 2px; border_width: 1px; border_color: Style.border;
                        VerticalLayout {
                            alignment: center; spacing: 4px;
                            Rectangle { width: 12px; height: 12px; border_radius: 6px; background: Style.ok; }
                            Text { text: "NODE_0" + node_id; font-size: 8px; color: #6E6E73; horizontal-alignment: center; }
                            Text { text: "CPU: " + Math.floor(cluster_health * 100 - node_id * 5) + "%"; font-size: Style.font-xxs; color: #888; horizontal-alignment: center; }
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: Style.border; }
            HorizontalLayout {
                spacing: 12px;
                Text { text: "TOTAL CLUSTER LOAD: " + Math.floor(400 * cluster_health) + " GFLOP/s"; font-size: 8px; color: #6E6E73; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }
}
