import { Style } from "../style.slint";

export component Z_AkashicRecord {
    in property <float> time;
    Rectangle {
        height: 160px; background: Style.surface; border_radius: 2px; border_width: 1px; border_color: Style.border;
        VerticalLayout {
            padding: 10px; spacing: 8px;
            Text { text: "Undo History"; font-size: Style.font-xxs; color: Style.brand; font-weight: 600; }
            Rectangle {
                vertical-stretch: 1; background: Style.surface-0; border_radius: 1px;
                for i in 6 : Rectangle { x: 10px + i * 15px; y: 10px + i * 20px; width: 30px; height: 1px; background: Style.brand; opacity: 0.3 * (i/6.0); }
            }
            Text { text: "1,402 states | 3 branches"; font-size: Style.font-xxs; color: Style.text-tertiary; font-weight: 500; }
        }
    }
}

export component Z_Oracle {
    in property <float> time;
    Rectangle {
        height: 120px; background: Style.surface; border_radius: 2px; border_width: 1px; border_color: Style.border;
        VerticalLayout {
            padding: 8px; spacing: 8px;
            Text { text: "Mix Analysis"; font-size: Style.font-xxs; color: Style.brand; font-weight: 600; }
            Rectangle {
                height: 60px; background: Style.surface-0; border_radius: 1px;
                Path {
                    stroke: Style.brand; stroke_width: 1.5px; opacity: 0.8; width: 100%; height: 100%; viewbox-width: 100; viewbox-height: 100;
                    MoveTo { x: 0; y: 80; }
                    CubicTo { control-1-x: 30; control-1-y: 20; control-2-x: 70; control-2-y: 90; x: 100; y: 10; }
                }
            }
            Text { text: "Energy peak: beat 128"; font-size: Style.font-xxs; color: Style.text-tertiary; font-weight: 500; }
        }
    }
}
