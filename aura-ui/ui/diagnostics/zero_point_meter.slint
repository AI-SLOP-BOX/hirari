import { Style } from "../style.slint";

export component Z_ZeroPointMeter {
    in property <float> entropy;
    Rectangle {
        height: 48px; background: Style.surface; border_radius: 2px; border_width: 1px; border_color: Style.border;
        VerticalLayout {
            padding: 6px; spacing: 4px;
            Text { text: "Information Density"; font-size: Style.font-xxs; color: Style.text-tertiary; font-weight: 600; }
            Rectangle {
                height: 14px; background: Style.surface-0; border_radius: 1px;
                HorizontalLayout {
                    padding: 2px; spacing: 1px;
                    for i in 20 : Rectangle {
                        horizontal-stretch: 1; height: 100%; 
                        background: entropy > (i/20.0) ? (i > 15 ? Style.record : (i > 10 ? Style.solo : Style.brand)) : Style.surface;
                    }
                }
            }
            Text { text: "Density: " + Math.round(entropy * 100) + "% | Minimal: " + (entropy < 0.01 ? "Yes" : "No"); font-size: Style.font-xxs; color: Style.text-tertiary; font-weight: 500; }
        }
    }
}
