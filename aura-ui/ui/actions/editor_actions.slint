// Non-destructive audio-region editing contract.
export global EditorActions {
    callback select_all_clips();
    callback clear_clip_selection();
    callback copy_selected_clips();
    callback paste_clips(float);
    callback split_clip(int, float);
    callback split_clip_with_crossfade(int, float, float);
    callback split_clip_at_silence(int, float, int);
    callback clip_moved(int, float);
    callback clip_gain_changed(int, float);
    callback apply_gain_staging(int, float);
    callback fade_changed(int, float, float);
    callback reverse_clip(int, bool);
    callback trim_clip(int, float, float);
    callback warp_clip(int, float);
    callback pitch_clip(int, float);
    callback loop_clip(int, int);
    callback duplicate_clip(int);
    callback remove_clip(int);
    callback repair_waveform(int);
    callback declip_waveform(int);
    callback reduce_noise_waveform(int);
    callback normalize_waveform(int);
    callback soft_clip_waveform(int);
    callback declick_waveform(int);
    callback stereo_width_waveform(int);
    callback detect_transients_waveform(int);
    callback mute_selection(int);
    callback normalize_selection_peak(int);
    callback normalize_selection_rms(int);
}
