import { Style } from "style.slint";

export component Z_ProFader {
    in-out property <float> value: 0.8;
    in property <string> label: "TRACK";
    VerticalLayout {
        spacing: 4px;
        Rectangle {
            width: 40px; height: 160px; background: Style.surface-0; border_width: 1px; border_color: Style.line-subtle;
            // Fader Track
            Rectangle {
                width: 2px; x: 19px; background: Style.surface-2;
                Rectangle { width: 1px; height: 100%; x: -1px; background: Style.line-subtle; }
            }
            // Quiet reference marks: enough for mix decisions without
            // turning the strip into a meter wall.
            Text { text: "0"; x: 3px; y: 8px; font-size: 8px; color: Style.text-tertiary; }
            Text { text: "-12"; x: 1px; y: 64px; font-size: 8px; color: Style.text-tertiary; }
            Text { text: "-24"; x: 1px; y: 112px; font-size: 8px; color: Style.text-tertiary; }
            // Fader Handle
            Rectangle {
                y: (1.0 - value.clamp(0.0, 1.0)) * 140px + 10px;
                width: 36px; height: 14px; x: 2px; background: Style.surface-3;
                border_radius: 2px; border_width: 1px; border_color: Style.surface-0;
                Rectangle { height: 2px; background: Style.brand; y: 6px; }
            }
            TouchArea { mouse-cursor: ns-resize; moved => { if (self.pressed) { root.value = (1.0 - (self.mouse_y - 8px) / 140px).clamp(0.0, 1.0); } } }
        }
        Text { text: Math.round((value.clamp(0.0, 1.0) * 60.0 - 60.0) * 10.0) / 10.0 + " dB"; font-family: Style.numeric-font; font-size: Style.font-xxs; color: Style.text-primary; horizontal-alignment: center; }
        Text { text: label; font-size: Style.font-xxs; color: Style.text-secondary; horizontal-alignment: center; }
    }
}

export component Z_PianoRollKey {
    in property <bool> isWhite;
    in property <bool> isSelected;
    Rectangle {
        height: 12px; width: isWhite ? 60px : 40px;
        background: isSelected ? Style.brand : (isWhite ? Style.text-primary : Style.surface-0);
        border_width: 0.5px; border_color: Style.line-strong;
    }
}

export component Z_TimelineRegion {
    in property <string> name;
    in property <color> col;
    Rectangle {
        border_radius: 3px; background: col.darker(50%); border_width: 1px; border_color: col;
        Text { text: name; font-size: Style.font-xs; color: Style.text-primary; x: 4px; y: 2px; }
    }
}

export component Z_IndustrialMeter {
    in property <float> level: 0.0; // 0 to 1
    Rectangle {
        width: 8px; height: 100%; background: Style.surface-0;
        Rectangle {
            y: parent.height - (level * parent.height);
            height: level * parent.height;
            background: @linear-gradient(0deg, Style.ok 0%, Style.solo 70%, Style.record 100%);
        }
    }
}

