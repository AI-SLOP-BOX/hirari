import { LineEdit, ScrollView } from "std-widgets.slint";
import { Style } from "./style.slint";
import { Z_IconButton } from "./primitives/icon_button.slint";
import { Z_Sample_Entry } from "./model/models.slint";
import { BrowserActions } from "./actions/browser_actions.slint";

export component Z_LibraryPage inherits Rectangle {
    in property <[Z_Sample_Entry]> entries;
    in-out property <string> query: "";
    callback preview(string);
    background: Style.surface;
    border-width: 1px;
    border-color: Style.border;
    HorizontalLayout {
        Rectangle {
            width: 150px; background: Style.panel;
            VerticalLayout {
                padding: 14px; spacing: 8px;
                Text { text: "Audio Library"; font-size: 15px; font-weight: 700; color: Style.text; }
                Text { text: "Indexed audio files"; font-size: 9px; color: Style.text-dim; }
                Rectangle { height: 1px; background: Style.border; }
                Rectangle {
                    height: 28px; background: Style.border;
                    HorizontalLayout { padding-left: 8px; Text { text: "Audio Files"; width: 100%; height: 100%; font-size: 10px; color: Style.text; vertical-alignment: center; } }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
        VerticalLayout {
            padding: 14px; spacing: 10px;
            HorizontalLayout {
                Text { text: "Audio Files"; font-size: 13px; font-weight: 600; color: Style.text; }
                Rectangle { horizontal-stretch: 1; }
                Z_IconButton { icon: "Scan"; compact: true; clicked => { BrowserActions.browser_scan(""); } }
                Text { text: entries.length + " items"; font-size: 9px; color: Style.text-muted; }
            }
            LineEdit {
                text <=> root.query;
                placeholder-text: "Search sounds";
                edited => { BrowserActions.browser_search(self.text); }
            }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 4px;
                    for entry in root.entries : Rectangle {
                        height: 42px; background: row_area.has-hover ? Style.panel-h : Style.panel; border-width: 1px; border-color: Style.border;
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 8px; spacing: 8px;
                            Rectangle { width: 4px; height: 22px; background: Style.brand; }
                            VerticalLayout { vertical-stretch: 1; Text { text: entry.name; font-size: 10px; color: Style.text; overflow: elide; } Text { text: entry.fmt + "  " + entry.sr + " Hz  " + entry.size; font-size: 8px; color: Style.text-muted; } }
                            Z_IconButton { icon: "Preview"; compact: true; clicked => { root.preview(entry.path != "" ? entry.path : entry.name); } }
                        }
                        row_area := TouchArea { mouse-cursor: pointer; clicked => { root.preview(entry.path != "" ? entry.path : entry.name); } }
                    }
                }
            }
        }
    }
}
