import { Style } from "../style.slint";

export component Z_SentinelRing {
    in property <float> cpu; in property <color> soul; in property <float> dna; in property <float> time;
    Rectangle {
        width: 300px; height: 300px;
        // Outer Ring (CPU/Load)
        Rectangle { 
            width: 100%; height: 100%; border_radius: 150px; border_width: 2px; border_color: Style.border;
            Rectangle { 
                width: 100%; height: 100%; border_radius: 150px; border_width: 4px; border_color: Style.brand;
                opacity: 0.2 + (cpu / 100.0) * 0.8;
                clip: true; // Visualization of load
            }
        }
        // Soul Core
        Rectangle { 
            width: 80px; height: 80px; background: soul.with-alpha(0.1); border_radius: 40px; border_width: 2px; border_color: soul;
            opacity: 0.6 + 0.4 * Math.sin(root.time / 100.0 * 1rad).abs();
            Text { text: "AURIC CORE"; font-size: Style.font-xxs; color: soul; font-weight: 950; horizontal-alignment: center; vertical-alignment: center; }
        }
        // DNA Pulse
        for i in 8 : Rectangle {
            x: 150px + 100px * Math.cos(i * 45deg + root.time / 500.0 * 1rad);
            y: 150px + 100px * Math.sin(i * 45deg + root.time / 500.0 * 1rad);
            width: 6px; height: 6px; background: dna > (i/8.0) ? Style.ok : #333; border_radius: 3px;
        }
    }
}
