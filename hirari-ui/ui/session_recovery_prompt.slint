import { Button } from "std-widgets.slint";
import { Style } from "style.slint";
import { Tr } from "locale/strings.slint";

export component Z_SessionRecoveryPrompt inherits Rectangle {
    callback recover();
    callback discard();
    callback later();
    in property <string> status: "";

    background: #00000099;
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: Math.min(540px, root.width - 32px);
                background: Style.surface-1;
                border-width: 1px;
                border-color: Style.brand;
                border-radius: 6px;
                VerticalLayout {
                    padding: 24px;
                    spacing: 14px;
                    Text {
                        text: Tr.tr("recovery_title");
                        color: Style.text-primary;
                        font-size: 18px;
                        font-weight: 700;
                        wrap: word-wrap;
                    }
                    Text {
                        text: Tr.tr("recovery_body");
                        color: Style.text-secondary;
                        font-size: 12px;
                        font-weight: 500;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: Tr.tr("recovery_recover"); clicked => { root.recover(); } }
                        Button { text: Tr.tr("recovery_discard"); clicked => { root.discard(); } }
                        Button { text: Tr.tr("recovery_later"); clicked => { root.later(); } }
                    }
                    Text {
                        text: root.status;
                        color: Style.text-tertiary;
                        font-size: 10px;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
