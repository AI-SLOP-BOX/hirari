export struct Z_AudioPitchAnchor {
    position_seconds: float,
    pitch_cents: float,
    formant_cents: float,
}

export struct Z_AudioPitchSegment {
    start_seconds: float,
    end_seconds: float,
    detected_pitch_cents: float,
    pitch_offset_cents: float,
    formant_offset_cents: float,
    anchor_count: int,
    anchors: [Z_AudioPitchAnchor],
}

export struct Z_Clip {
    id: int,
    name: string,
    source_path: string,
    start_beat: float,
    length_beats: float,
    color: color,
    points: [float],
    fade_in: float,
    fade_out: float,
    gain: float,
    reverse: bool,
    warp_ratio: float,
    pitch_preserve_warp: bool,
    pitch_semitones: float,
    loop_count: int,
    sync_group: int,
    trim_start: float,
    trim_end: float,
    layer: int,
    selected: bool,
    missing: bool,
    audio_pitch_segments: [Z_AudioPitchSegment],
}
