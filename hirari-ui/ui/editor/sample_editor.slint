import { Style } from "../style.slint";
import { Button } from "std-widgets.slint";
import { Z_IconButton } from "../primitives/icon_button.slint";
import { Z_Clip } from "../model/clip_model.slint";

export component Z_SampleEditor {
    callback select-clip(int);
    callback scrub-to-beat(float);
    callback apply-gain(float);
    callback apply-fades(float, float);
    callback apply-reverse(bool);
    callback apply-trim(float, float);
    callback apply-warp(float);
    callback apply-pitch(float);
    callback analyze-audio-pitch();
    callback adjust-audio-pitch-segment(float, float, float, float);
    callback extract-audio-pitch-to-midi();
    callback set-audio-pitch-anchor(float, float, float, float);
    callback set-audio-formant-anchor(float, float, float);
    callback move-audio-anchor(float, float, float, float, bool);
    callback warp-audio-pitch-segment(float, float, float);
    callback apply-loop(int);
    callback repair-waveform();
    callback declip-waveform();
    callback reduce-noise-waveform();
    callback normalize-waveform();
    callback soft-clip-waveform();
    callback declick-waveform();
    callback stereo-width-waveform();
    callback detect-transients-waveform();
    callback mute-selection();
    callback normalize-selection-peak();
    callback normalize-selection-rms();
    callback duplicate-clip();
    callback remove-clip();
    in property <float> initial-trim-start: 0.0;
    in property <float> initial-trim-end: 1.0;
    in property <[Z_Clip]> clips: [];
    in property <int> selected-clip-id: -1;
    in property <int> track-id: -1;
    in property <float> playhead-beat: 0.0;
    in-out property <[float]> samples;
    in-out property <color> wave_col: Style.brand;

    // Interactive states
    in-out property <float> trim_start: initial-trim-start; // normalized 0.0 - 1.0
    in-out property <float> trim_end: initial-trim-end;   // normalized 0.0 - 1.0
    in-out property <float> scale_multiplier: 1.0; // modified by Normalize
    in-out property <bool> is_reversed: false;
    in-out property <bool> is_faded: false;
    in-out property <float> flex_ratio: 1.0;
    in-out property <float> pitch_semitones: 0.0;
    in-out property <int> loop_count: 1;
    in-out property <bool> formant_edit_mode: false;
    in-out property <float> dragged_anchor_position: -1.0;
    in-out property <float> dragged_anchor_value: 0.0;
    in-out property <bool> did_drag_anchor: false;
    in property <image> gpu-waveform-image;
    in property <image> gpu-spectrum-image;

    Rectangle {
        background: Style.surface; border_width: 1.5px; border_color: Style.border;
        HorizontalLayout {
            spacing: 8px;
            // Project regions for the selected track.
            Rectangle { width: 184px; background: Style.surface-1; border_width: 1px; border_color: Style.border; border_radius: 5px;
                VerticalLayout { spacing: 0px;
                    Rectangle { height: 38px; background: Style.surface-2; HorizontalLayout { padding: 10px; Text { text: "Regions"; color: Style.text-primary; font-size: 11px; font-weight: 700; } Rectangle { horizontal-stretch: 1; } Text { text: clips.length + " clips"; color: Style.text-tertiary; font-size: 9px; } } }
                    for clip[idx] in clips : Rectangle {
                        height: 48px; x: 8px; width: parent.width - 16px;
                        background: clip.id == selected-clip-id ? Style.selection : transparent;
                        border_radius: 4px;
                        HorizontalLayout {
                            padding: 6px; spacing: 7px;
                            Rectangle { width: 5px; height: 30px; background: clip.color; border_radius: 3px; }
                            VerticalLayout {
                                alignment: center;
                                Text { text: clip.name; color: Style.text-primary; font-size: 9px; overflow: elide; }
                                Text { text: "Beat " + clip.start_beat + " · " + clip.length_beats + " beats"; color: Style.text-tertiary; font-size: 8px; }
                            }
                        }
                        TouchArea { clicked => { root.select-clip(clip.id); } }
                    }
                    if (clips.length == 0) : Text { text: "This track has no regions."; x: 8px; width: parent.width - 16px; color: Style.text-muted; font-size: 9px; wrap: word-wrap; }
                    Rectangle { vertical-stretch: 1; }
                }
            }
            VerticalLayout {
            horizontal-stretch: 1;
            padding: 12px; spacing: 10px;

            // Header controls
            HorizontalLayout {
                spacing: 12px;
                Text { text: "Waveform Editor"; font-size: 14px; color: Style.text-primary; font-weight: 700; vertical-alignment: center; }
                Text { text: "WAVEFORM"; font-size: 9px; color: Style.brand; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }

                Z_IconButton {
                    icon: "NORMALIZE";
                    enabled: selected-clip-id >= 0;
                    active: scale_multiplier > 1.0;
                    clicked => {
                        scale_multiplier = scale_multiplier == 1.0 ? 1.4 : 1.0;
                        root.apply-gain(scale_multiplier);
                    }
                }
                Z_IconButton {
                    icon: "REVERSE";
                    enabled: selected-clip-id >= 0;
                    active: is_reversed;
                    clicked => {
                        is_reversed = !is_reversed;
                        root.apply-reverse(is_reversed);
                    }
                }
                Z_IconButton {
                    icon: "FADE IN/OUT";
                    enabled: selected-clip-id >= 0;
                    active: is_faded;
                    clicked => {
                        is_faded = !is_faded;
                        root.apply-fades(is_faded ? 0.05 : -0.05, is_faded ? 0.05 : -0.05);
                    }
                }
                Z_IconButton { icon: "PITCH"; enabled: selected-clip-id >= 0; active: pitch_semitones != 0.0; clicked => { pitch_semitones = pitch_semitones == 0.0 ? 1.0 : 0.0; root.apply-pitch(pitch_semitones); } }
                Z_IconButton { icon: "ANALYZE PITCH"; enabled: selected-clip-id >= 0; clicked => { root.analyze-audio-pitch(); } }
                Button { text: formant_edit_mode ? "FORMANT EDIT" : "PITCH EDIT"; height: 24px; clicked => { formant_edit_mode = !formant_edit_mode; } }
                Z_IconButton { icon: "LOOP"; enabled: selected-clip-id >= 0; active: loop_count > 1; clicked => { loop_count = loop_count == 1 ? 2 : (loop_count == 2 ? 4 : 1); root.apply-loop(loop_count); } }
                Z_IconButton { icon: "REPAIR"; enabled: selected-clip-id >= 0; clicked => { root.repair-waveform(); } }
                Z_IconButton { icon: "DECLIP"; enabled: selected-clip-id >= 0; clicked => { root.declip-waveform(); } }
                Z_IconButton { icon: "DENOISE"; enabled: selected-clip-id >= 0; clicked => { root.reduce-noise-waveform(); } }
                Z_IconButton { icon: "MASTER"; enabled: selected-clip-id >= 0; clicked => { root.normalize-waveform(); root.soft-clip-waveform(); } }
                Z_IconButton { icon: "DECLICK"; enabled: selected-clip-id >= 0; clicked => { root.declick-waveform(); } }
                Z_IconButton { icon: "STEREO"; enabled: selected-clip-id >= 0; clicked => { root.stereo-width-waveform(); } }
                Z_IconButton { icon: "TRANSIENT"; enabled: selected-clip-id >= 0; clicked => { root.detect-transients-waveform(); } }
                Z_IconButton { icon: "MUTE SEL"; enabled: selected-clip-id >= 0; clicked => { root.mute-selection(); } }
                Z_IconButton { icon: "PEAK SEL"; enabled: selected-clip-id >= 0; clicked => { root.normalize-selection-peak(); } }
                Z_IconButton { icon: "RMS SEL"; enabled: selected-clip-id >= 0; clicked => { root.normalize-selection-rms(); } }
                Z_IconButton { icon: "DUPLICATE"; enabled: selected-clip-id >= 0; clicked => { root.duplicate-clip(); } }
                Z_IconButton { icon: "DELETE CLIP"; enabled: selected-clip-id >= 0; clicked => { root.remove-clip(); } }
                Z_IconButton {
                    icon: "RESET TRIM";
                    enabled: selected-clip-id >= 0;
                    clicked => {
                        trim_start = 0.0;
                        trim_end = 1.0;
                        root.apply-trim(trim_start, trim_end);
                    }
                }
            }
            Text { text: "Gain, fades, trim, reverse, Flex, pitch and loop count are saved with the project"; font-size: Style.font-xxs; color: Style.text-muted; }

            // Waveform Canvas
            Rectangle {
                background: #020202; border_width: 1px; border_color: Style.surface; height: 180px; clip: true;

                if (gpu-waveform-image.width > 0) : Image {
                    source: gpu-waveform-image; x: 10px; y: 10px;
                    width: parent.width - 20px; height: parent.height - 20px;
                    image-fit: fill; opacity: 0.92;
                }

                // Trim region selection background shading
                Rectangle {
                    x: trim_start * parent.width;
                    width: (trim_end - trim_start) * parent.width;
                    height: 100%;
                    background: Style.brand.with-alpha(0.05);
                }

                // Bipolar Waveform rendering
                if (gpu-waveform-image.width <= 0) : HorizontalLayout {
                    spacing: 2px; padding-left: 10px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px;
                    for s[idx] in samples : VerticalLayout {
                        alignment: center;

                        // Calculate sample values taking into account reverse and fade effects
                        property <int> mapped_idx: is_reversed ? (samples.length - 1 - idx) : idx;
                        property <float> base_val: samples[mapped_idx];

                        // Apply fade curve
                        property <float> fade_factor: is_faded ? (
                            idx < 5 ? (idx / 5.0) :
                            (idx > (samples.length - 6) ? ((samples.length - 1 - idx) / 5.0) : 1.0)
                        ) : 1.0;

                        property <float> final_h: (base_val * scale_multiplier * fade_factor).clamp(0.0, 1.0);

                        // Check if outside trim boundaries
                        property <float> norm_pos: idx / samples.length;
                        property <bool> is_trimmed: (norm_pos < trim_start || norm_pos > trim_end);

                        Rectangle {
                            width: 3px; height: final_h * 140.0 * 1px;
                            background: is_trimmed ? #333 : wave_col;
                            border_radius: 1.5px;
                            opacity: is_trimmed ? 0.3 : 0.9;
                            animate height { duration: 150ms; }
                            animate background { duration: 150ms; }
                        }
                    }
                }

                // Center line
                Rectangle { height: 1px; background: Style.border; width: 100%; y: parent.height / 2; opacity: 0.3; }

                // Scrubbing is mapped through the selected region's actual
                // beat range. The region handles below remain above this area.
                for clip in clips : Rectangle {
                    visible: clip.id == selected-clip-id;
                    width: 100%; height: 100%;
                    Rectangle {
                        visible: clip.length_beats > 0.0 && playhead-beat >= clip.start_beat && playhead-beat <= clip.start_beat + clip.length_beats;
                        x: ((playhead-beat - clip.start_beat) / (clip.length_beats > 0.0 ? clip.length_beats : 1.0)) * parent.width;
                        width: 2px; height: 100%; background: Style.ok;
                    }
                    TouchArea {
                        clicked => {
                            if (clip.length_beats > 0.0) {
                                root.scrub-to-beat(clip.start_beat + (self.mouse_x / parent.width).clamp(0.0, 1.0) * clip.length_beats);
                            }
                        }
                    }
                }

                // Draggable Trim Handles
                // Start Bracket handle
                Rectangle {
                    x: trim_start * parent.width - 4px; width: 8px; height: 100%;
                    background: transparent;
                    Rectangle { width: 2px; height: 100%; background: Style.alert; x: 3px; }
                    // Handle tab
                    Rectangle { width: 8px; height: 20px; background: Style.alert; border_radius: 2px; y: 80px; }
                    TouchArea {
                        moved => {
                            if (self.pressed) {
                                trim_start = (trim_start + (self.mouse_x - self.pressed_x) / parent.width).clamp(0.0, trim_end - 0.1);
                                root.apply-trim(trim_start, trim_end);
                            }
                        }
                    }
                }
                // End Bracket handle
                Rectangle {
                    x: trim_end * parent.width - 4px; width: 8px; height: 100%;
                    background: transparent;
                    Rectangle { width: 2px; height: 100%; background: Style.alert; x: 3px; }
                    // Handle tab
                    Rectangle { width: 8px; height: 20px; background: Style.alert; border_radius: 2px; y: 80px; }
                    TouchArea {
                        moved => {
                            if (self.pressed) {
                                trim_end = (trim_end + (self.mouse_x - self.pressed_x) / parent.width).clamp(trim_start + 0.1, 1.0);
                                root.apply-trim(trim_start, trim_end);
                            }
                        }
                    }
                }

                if (gpu-waveform-image.width <= 0 && samples.length == 0) : Text {
                    text: "No waveform preview is available for the selected region.";
                    x: 12px; y: 12px; color: Style.text-muted; font-size: 9px;
                }
            }

            if (gpu-spectrum-image.width > 0) : Rectangle {
                height: 54px; background: #050812; border_width: 1px; border_color: Style.border;
                Image { source: gpu-spectrum-image; x: 8px; y: 4px; width: parent.width - 16px; height: parent.height - 8px; image-fit: fill; }
                Text { text: "GPU SPECTRUM"; x: 12px; y: 6px; font-size: 8px; color: Style.text-tertiary; }
            }

            Text { text: selected-clip-id < 0 ? "Select a region to edit its audio properties." : "Editing region " + selected-clip-id + " on track " + track-id; font-size: Style.font-xxs; color: Style.text-muted; }
            }
            // Inspector reads the selected project region.
            Rectangle { width: 220px; background: Style.surface-1; border_width: 1px; border_color: Style.border; border_radius: 5px;
                VerticalLayout { spacing: 0px;
                    Rectangle { height: 38px; background: Style.surface-2; HorizontalLayout { padding: 10px; Text { text: "Selected Region"; color: Style.text-primary; font-size: 11px; font-weight: 700; } } }
                    if (selected-clip-id < 0) : Text { text: "No region selected."; color: Style.text-muted; font-size: 9px; }
                    for clip in clips : VerticalLayout {
                        if (clip.id == selected-clip-id) : VerticalLayout {
                            padding: 12px; spacing: 8px;
                            Text { text: clip.name; color: Style.text-primary; font-size: 13px; font-weight: 700; overflow: elide; }
                            Text { text: "Track " + track-id; color: Style.text-tertiary; font-size: 9px; }
                            Text { text: "Start beat  " + clip.start_beat; color: Style.text-secondary; font-size: 9px; }
                            Text { text: "Length  " + clip.length_beats + " beats"; color: Style.text-secondary; font-size: 9px; }
                            Text { text: "Gain  " + clip.gain; color: Style.text-secondary; font-size: 9px; }
                            Text { text: "Trim  " + clip.trim_start + " – " + clip.trim_end; color: Style.text-secondary; font-size: 9px; }
                            Text { text: "Reverse  " + (clip.reverse ? "On" : "Off"); color: Style.text-secondary; font-size: 9px; }
                            Text { text: "Playback speed  " + clip.warp_ratio + "x"; color: Style.text-secondary; font-size: 9px; }
                            Text { text: "Pitch  " + clip.pitch_semitones + " st"; color: Style.text-secondary; font-size: 9px; }
                            Text { text: "Loop count  " + clip.loop_count; color: Style.text-secondary; font-size: 9px; }
                            Text { text: "Detected pitch segments  " + clip.audio_pitch_segments.length; color: Style.text-secondary; font-size: 9px; }
                            Button {
                                text: "Extract MIDI notes";
                                enabled: clip.audio_pitch_segments.length > 0;
                                clicked => { root.extract-audio-pitch-to-midi(); }
                            }
                            for segment in clip.audio_pitch_segments : Rectangle {
                                height: 86px; background: Style.surface-2; border-radius: 3px;
                                VerticalLayout {
                                    padding: 5px; spacing: 3px;
                                    Text {
                                        text: "MIDI " + Math.round((segment.detected_pitch_cents + segment.pitch_offset_cents) / 100.0)
                                            + " · formant " + Math.round(segment.formant_offset_cents) + " cents"
                                            + " · " + segment.anchor_count + " points · click "
                                            + (root.formant_edit_mode ? "formant" : "pitch") + " curve to edit";
                                        color: Style.text-secondary; font-size: 8px;
                                    }
                                    Rectangle {
                                        height: 52px; background: Style.surface; border-width: 1px;
                                        border-color: Style.border; border-radius: 2px; clip: true;
                                        Rectangle { y: parent.height / 2.0; width: parent.width; height: 1px; background: Style.border; }
                                        if (segment.anchors.length > 1) : Rectangle {
                                            width: 100%; height: 100%;
                                            for i in (segment.anchors.length - 1) : Path {
                                                width: 100%; height: 100%; stroke: Style.brand; stroke_width: 1.5px;
                                                MoveTo {
                                                    x: ((segment.anchors[i].position_seconds - segment.start_seconds)
                                                        / (segment.end_seconds - segment.start_seconds)) * (parent.width / 1px);
                                                    y: (0.5 - (root.formant_edit_mode
                                                        ? (segment.anchors[i].formant_cents + segment.formant_offset_cents).clamp(-2400.0, 2400.0) / 4800.0
                                                        : (segment.anchors[i].pitch_cents + segment.pitch_offset_cents).clamp(-1200.0, 1200.0) / 2400.0))
                                                        * (parent.height / 1px);
                                                }
                                                LineTo {
                                                    x: ((segment.anchors[i + 1].position_seconds - segment.start_seconds)
                                                        / (segment.end_seconds - segment.start_seconds)) * (parent.width / 1px);
                                                    y: (0.5 - (root.formant_edit_mode
                                                        ? (segment.anchors[i + 1].formant_cents + segment.formant_offset_cents).clamp(-2400.0, 2400.0) / 4800.0
                                                        : (segment.anchors[i + 1].pitch_cents + segment.pitch_offset_cents).clamp(-1200.0, 1200.0) / 2400.0))
                                                        * (parent.height / 1px);
                                                }
                                            }
                                        }
                                        TouchArea {
                                            pointer-event(event) => {
                                                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                                    root.did_drag_anchor = false;
                                                }
                                            }
                                            clicked => {
                                                let duration = segment.end_seconds - segment.start_seconds;
                                                if (!root.did_drag_anchor && duration > 0.0 && parent.width > 0px && parent.height > 0px) {
                                                    let position = segment.start_seconds
                                                        + (self.mouse_x / parent.width).clamp(0.0, 1.0) * duration;
                                                    if (root.formant_edit_mode) {
                                                        root.set-audio-formant-anchor(
                                                            segment.start_seconds, position,
                                                            (0.5 - self.mouse_y / parent.height).clamp(-0.5, 0.5) * 4800.0);
                                                    } else {
                                                        root.set-audio-pitch-anchor(
                                                            segment.start_seconds, position,
                                                            (0.5 - self.mouse_y / parent.height).clamp(-0.5, 0.5) * 2400.0,
                                                            segment.formant_offset_cents);
                                                    }
                                                }
                                            }
                                        }
                                        for anchor in segment.anchors : Rectangle {
                                            width: 6px; height: 6px;
                                            x: ((anchor.position_seconds - segment.start_seconds)
                                                / (segment.end_seconds - segment.start_seconds)).clamp(0.0, 1.0)
                                                * (parent.width - self.width);
                                            y: (0.5 - (root.formant_edit_mode
                                                ? (anchor.formant_cents + segment.formant_offset_cents).clamp(-2400.0, 2400.0) / 4800.0
                                                : (anchor.pitch_cents + segment.pitch_offset_cents).clamp(-1200.0, 1200.0) / 2400.0))
                                                * (parent.height - self.height);
                                            background: root.formant_edit_mode ? Style.solo : Style.brand; border-radius: 3px;
                                        }
                                        for anchor in segment.anchors : TouchArea {
                                            width: 18px; height: 18px;
                                            x: ((anchor.position_seconds - segment.start_seconds)
                                                / (segment.end_seconds - segment.start_seconds)).clamp(0.0, 1.0)
                                                * (parent.width - 6px) - 6px;
                                            y: (0.5 - (root.formant_edit_mode
                                                ? (anchor.formant_cents + segment.formant_offset_cents).clamp(-2400.0, 2400.0) / 4800.0
                                                : (anchor.pitch_cents + segment.pitch_offset_cents).clamp(-1200.0, 1200.0) / 2400.0))
                                                * (parent.height - 6px) - 6px;
                                            pointer-event(event) => {
                                                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                                    root.dragged_anchor_position = anchor.position_seconds;
                                                    root.dragged_anchor_value = root.formant_edit_mode
                                                        ? anchor.formant_cents + segment.formant_offset_cents
                                                        : anchor.pitch_cents + segment.pitch_offset_cents;
                                                    root.did_drag_anchor = false;
                                                } else if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                                                    root.dragged_anchor_position = -1.0;
                                                } else if (event.kind == PointerEventKind.cancel) {
                                                    root.dragged_anchor_position = -1.0;
                                                }
                                            }
                                            moved => {
                                                let duration = segment.end_seconds - segment.start_seconds;
                                                if (self.pressed && duration > 0.0 && parent.width > 0px && parent.height > 0px) {
                                                    let position = (root.dragged_anchor_position
                                                        + (self.mouse_x - self.width / 2.0) / parent.width * duration)
                                                        .clamp(segment.start_seconds, segment.end_seconds);
                                                    let value = (root.dragged_anchor_value
                                                        - (self.mouse_y - self.height / 2.0) / parent.height
                                                        * (root.formant_edit_mode ? 4800.0 : 2400.0))
                                                        .clamp(root.formant_edit_mode ? -2400.0 : -1200.0,
                                                               root.formant_edit_mode ? 2400.0 : 1200.0);
                                                    root.move-audio-anchor(segment.start_seconds,
                                                        root.dragged_anchor_position, position, value,
                                                        root.formant_edit_mode);
                                                    root.dragged_anchor_position = position;
                                                    root.dragged_anchor_value = value;
                                                    root.did_drag_anchor = true;
                                                }
                                            }
                                        }

                                    }
                                    HorizontalLayout {
                                        Button {
                                            text: "S−"; width: 38px; height: 18px;
                                            clicked => {
                                                root.warp-audio-pitch-segment(
                                                    segment.start_seconds,
                                                    (segment.start_seconds - 0.01).max(0.0),
                                                    segment.end_seconds);
                                            }
                                        }
                                        Button {
                                            text: "S+"; width: 38px; height: 18px;
                                            enabled: segment.end_seconds - segment.start_seconds > 0.01;
                                            clicked => {
                                                root.warp-audio-pitch-segment(
                                                    segment.start_seconds,
                                                    (segment.start_seconds + 0.01).min(segment.end_seconds - 0.01),
                                                    segment.end_seconds);
                                            }
                                        }
                                        Button {
                                            text: "−"; width: 22px; height: 18px;
                                            clicked => {
                                                root.adjust-audio-pitch-segment(
                                                    segment.start_seconds, segment.end_seconds,
                                                    (segment.pitch_offset_cents - 100.0).clamp(-4800.0, 4800.0),
                                                    segment.formant_offset_cents);
                                            }
                                        }
                                        Button {
                                            text: "+"; width: 22px; height: 18px;
                                            clicked => {
                                                root.adjust-audio-pitch-segment(
                                                    segment.start_seconds, segment.end_seconds,
                                                    (segment.pitch_offset_cents + 100.0).clamp(-4800.0, 4800.0),
                                                segment.formant_offset_cents);
                                            }
                                        }
                                        Button {
                                            text: "F−"; width: 22px; height: 18px;
                                            clicked => {
                                                root.adjust-audio-pitch-segment(
                                                    segment.start_seconds, segment.end_seconds,
                                                    segment.pitch_offset_cents,
                                                    (segment.formant_offset_cents - 100.0).clamp(-2400.0, 2400.0));
                                            }
                                        }
                                        Button {
                                            text: "F+"; width: 22px; height: 18px;
                                            clicked => {
                                                root.adjust-audio-pitch-segment(
                                                    segment.start_seconds, segment.end_seconds,
                                                    segment.pitch_offset_cents,
                                                    (segment.formant_offset_cents + 100.0).clamp(-2400.0, 2400.0));
                                            }
                                        }
                                        Button {
                                            text: "E−"; width: 38px; height: 18px;
                                            enabled: segment.end_seconds - segment.start_seconds > 0.01;
                                            clicked => {
                                                root.warp-audio-pitch-segment(
                                                    segment.start_seconds, segment.start_seconds,
                                                    (segment.end_seconds - 0.01).max(segment.start_seconds + 0.01));
                                            }
                                        }
                                        Button {
                                            text: "E+"; width: 38px; height: 18px;
                                            clicked => {
                                                root.warp-audio-pitch-segment(
                                                    segment.start_seconds, segment.start_seconds,
                                                    segment.end_seconds + 0.01);
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
        }
    }
}
