import { Style } from "../style.slint";
import { Z_SampleEditor } from "./sample_editor.slint";
import { Z_Clip } from "../model/clip_model.slint";

// Keeps the editor view independent from the global action contract.
export component Z_SampleEditorAdapter {
    in-out property <[float]> samples;
    in-out property <color> wave_col: Style.brand;
    in property <int> clip-id: -1;
    in property <int> track-id: -1;
    in property <[Z_Clip]> clips: [];
    in property <float> playhead-beat: 0.0;
    in property <bool> reversed: false;
    in property <float> trim-start: 0.0;
    in property <float> trim-end: 1.0;
    in property <float> flex-ratio: 1.0;
    in property <float> pitch-semitones: 0.0;
    in property <int> loop-count: 1;
    in property <image> gpu-waveform-image;
    in property <image> gpu-spectrum-image;
    callback apply-gain(float);
    callback apply-fades(float, float);
    callback apply-reverse(bool);
    callback apply-trim(float, float);
    callback apply-warp(float);
    callback apply-pitch(float);
    callback analyze-audio-pitch();
    callback adjust-audio-pitch-segment(float, float, float, float);
    callback extract-audio-pitch-to-midi();
    callback set-audio-pitch-anchor(float, float, float, float);
    callback set-audio-formant-anchor(float, float, float);
    callback move-audio-anchor(float, float, float, float, bool);
    callback warp-audio-pitch-segment(float, float, float);
    callback apply-loop(int);
    callback duplicate-clip();
    callback remove-clip();
    callback select-clip(int);
    callback scrub-to-beat(float);
    callback repair-waveform();
    callback declip-waveform();
    callback reduce-noise-waveform();
    callback normalize-waveform();
    callback soft-clip-waveform();
    callback declick-waveform();
    callback stereo-width-waveform();
    callback detect-transients-waveform();
    callback mute-selection();
    callback normalize-selection-peak();
    callback normalize-selection-rms();

    Z_SampleEditor {
        samples: root.samples;
        clips: root.clips;
        selected-clip-id: root.clip-id;
        track-id: root.track-id;
        playhead-beat: root.playhead-beat;
        wave_col: root.wave_col;
        is_reversed: root.reversed;
        initial-trim-start: root.trim-start;
        initial-trim-end: root.trim-end;
        flex_ratio: root.flex-ratio;
        pitch_semitones: root.pitch-semitones;
        loop_count: root.loop-count;
        gpu-waveform-image: root.gpu-waveform-image;
        gpu-spectrum-image: root.gpu-spectrum-image;
        apply-gain(value) => { root.apply-gain(value); }
        apply-fades(fade-in, fade-out) => { root.apply-fades(fade-in, fade-out); }
        apply-reverse(value) => { root.apply-reverse(value); }
        apply-trim(start, end) => { root.apply-trim(start, end); }
        apply-warp(ratio) => { root.apply-warp(ratio); }
        apply-pitch(semitones) => { root.apply-pitch(semitones); }
        analyze-audio-pitch => { root.analyze-audio-pitch(); }
        adjust-audio-pitch-segment(start, end, pitch, formant) => { root.adjust-audio-pitch-segment(start, end, pitch, formant); }
        extract-audio-pitch-to-midi => { root.extract-audio-pitch-to-midi(); }
        set-audio-pitch-anchor(segment_start, position, pitch, formant) => {
            root.set-audio-pitch-anchor(segment_start, position, pitch, formant);
        }
        set-audio-formant-anchor(segment_start, position, formant) => {
            root.set-audio-formant-anchor(segment_start, position, formant);
        }
        move-audio-anchor(segment_start, old_position, position, value, formant) => {
            root.move-audio-anchor(segment_start, old_position, position, value, formant);
        }
        warp-audio-pitch-segment(segment_start, new_start, new_end) => {
            root.warp-audio-pitch-segment(segment_start, new_start, new_end);
        }
        apply-loop(count) => { root.apply-loop(count); }
        duplicate-clip => { root.duplicate-clip(); }
        remove-clip => { root.remove-clip(); }
        select-clip(id) => { root.select-clip(id); }
        scrub-to-beat(beat) => { root.scrub-to-beat(beat); }
        repair-waveform => { root.repair-waveform(); }
        declip-waveform => { root.declip-waveform(); }
        reduce-noise-waveform => { root.reduce-noise-waveform(); }
        normalize-waveform => { root.normalize-waveform(); }
        soft-clip-waveform => { root.soft-clip-waveform(); }
        declick-waveform => { root.declick-waveform(); }
        stereo-width-waveform => { root.stereo-width-waveform(); }
        detect-transients-waveform => { root.detect-transients-waveform(); }
        mute-selection => { root.mute-selection(); }
        normalize-selection-peak => { root.normalize-selection-peak(); }
        normalize-selection-rms => { root.normalize-selection-rms(); }
    }
}
