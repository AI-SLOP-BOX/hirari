import { Style } from "../style.slint";

export component Z_LiveLoops {
    in property <string> project_name;
    Rectangle {
        background: Style.surface; border-width: 1px; border-color: Style.border; border-radius: 3px;
        VerticalLayout {
            padding: 10px; spacing: 8px;
            HorizontalLayout { Text { text: "Live Loops"; font-size: Style.font-m; color: Style.text; font-weight: 600; } Rectangle { horizontal-stretch: 1; } Text { text: project_name; font-size: Style.font-s; color: Style.text-dim; } }
            for row in 4 : HorizontalLayout {
                spacing: 4px; horizontal-stretch: 1;
                for col in 4 : cell := Rectangle {
                    property <bool> active: Math.mod(row + col, 3) == 0;
                    height: 42px; horizontal-stretch: 1; border-radius: 3px;
                    background: cell.active ? Style.cycle.with-alpha(0.72) : Style.panel;
                    border-width: 1px; border-color: cell.active ? Style.cycle : Style.border;
                    Text { text: "" + (row * 4 + col + 1); width: 100%; height: 100%; color: cell.active ? #101010 : Style.text-muted; font-family: Style.numeric-font; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            Text { text: "Live Loop launch is not available in preview"; font-size: Style.font-xxs; color: Style.text-muted; }
        }
    }
}
