import { Style } from "../style.slint";

export component Z_Knob {
    in property <float> value: 0.5;
    in property <string> label: "";
    in property <color> accent-col: Style.brand;
    in property <bool> bipolar: false;
    in property <bool> compact: false;
    in property <bool> show-value: compact;
    in property <string> unit: "%";
    in property <string> display-value: "";
    callback changed(float);

    width: compact ? 36px : 56px; height: compact ? 42px : 64px;
    VerticalLayout {
        alignment: center; spacing: 4px;
        Rectangle {
            width: compact ? 28px : 48px; height: compact ? 28px : 48px;
            background: Style.panel; border-radius: compact ? 14px : 24px;
            border-width: 1px; border-color: Style.border;
            Path {
                width: 100%; height: 100%; stroke: Style.border; stroke-width: 2px;
                MoveTo { x: compact ? 5 : 8; y: compact ? 22 : 38; }
                ArcTo { radius-x: compact ? 8 : 14; radius-y: compact ? 8 : 14; x: compact ? 23 : 40; y: compact ? 22 : 38; sweep: true; }
            }
            Path {
                width: 100%; height: 100%; stroke: accent-col; stroke-width: compact ? 1.5px : 2px; opacity: 0.6;
                MoveTo { x: (bipolar ? (compact ? 14 : 24) : (compact ? 5 : 8)); y: (bipolar ? (compact ? 5 : 10) : (compact ? 22 : 38)); }
                ArcTo {
                    radius-x: compact ? 8 : 14; radius-y: compact ? 8 : 14;
                    x: (bipolar ? ((compact ? 14.0 : 24.0) + (compact ? 8.0 : 14.0) * Math.sin((value - 0.5) * 270deg)) : ((compact ? 14.0 : 24.0) + (compact ? 8.0 : 14.0) * Math.sin((value - 1.0) * 270deg)));
                    y: (bipolar ? ((compact ? 14.0 : 24.0) - (compact ? 8.0 : 14.0) * Math.cos((value - 0.5) * 270deg)) : ((compact ? 14.0 : 24.0) - (compact ? 8.0 : 14.0) * Math.cos((value - 1.0) * 270deg)));
                    sweep: (value > (bipolar ? 0.5 : 0.0));
                }
            }
            Text {
                text: "┃"; font-family: Style.ui-font; font-size: compact ? 12px : 16px;
                font-weight: 900; color: accent-col;
                x: (compact ? 14px : 24px) - self.width / 2; y: compact ? 2px : 4px;
                opacity: ta.has-hover ? 1.0 : 0.8;
                transform-rotation: (value - (bipolar ? 0.5 : 0.0)) * 270deg;
            }
            ta := TouchArea {
                property <bool> dragging: false;
                property <float> drag-value: 0.5;
                property <float> drag-y: 0.0;
                // Keep the visual control compact, but give it the full
                // knob-sized hit target so precision does not depend on the
                // pointer landing on the arc itself.
                x: -4px; y: -4px;
                width: parent.width + 8px; height: parent.height + 8px;
                mouse-cursor: ns-resize;
                moved => {
                    if (self.pressed) {
                        if (!self.dragging) {
                            self.drag-value = root.value;
                            self.drag-y = self.mouse_y / 1px;
                            self.dragging = true;
                        }
                        let delta = (self.drag-y - self.mouse_y / 1px) / -100.0;
                        root.changed((self.drag-value + delta).clamp(0.0, 1.0));
                    } else {
                        self.dragging = false;
                    }
                }
            }
        }
        Text {
            text: display-value != "" ? display-value : (bipolar ? (Math.round((value - 0.5) * 200.0) + unit) : (Math.round(value * 100.0) + unit));
            height: 10px; font-family: Style.numeric-font; font-size: Style.font-xxs;
            color: Style.text-primary; opacity: show-value || ta.has-hover ? 1.0 : 0.0; horizontal-alignment: center;
        }
        if (label != "") : Text {
            text: label; font-family: Style.ui-font; font-size: Style.font-xs;
            font-weight: 500; color: Style.text-dim; horizontal-alignment: center;
        }
    }
}
