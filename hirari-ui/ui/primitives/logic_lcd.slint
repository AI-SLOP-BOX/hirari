import { Style } from "../style.slint";

export component Z_LogicLCD {
    in property <float> ph;
    in property <float> bpm;
    in property <string> time-sig;
    in-out property <int> display-mode: 0; // 0: beats, 1: time, 2: SMPTE

    min-width: 340px;
    height: 38px;
    Rectangle {
        width: 100%; height: 100%; background: Style.lcd-bg;
        border-radius: 4px;
        border-width: 1px;
        border-color: Style.border;
        HorizontalLayout {
            padding-left: 16px; padding-right: 16px; spacing: 20px;
            alignment: center;
            VerticalLayout {
                alignment: center;
                Text { text: "POSITION"; font-size: Style.font-xxs; color: Style.text-muted; font-weight: 700; }
                Text {
                    text: root.display-mode == 0 ? Math.floor(root.ph / 4.0 + 1) + " . " + (Math.floor(Math.mod(root.ph, 4.0)) + 1) + " . " + (Math.floor(Math.mod(root.ph * 4.0, 4.0)) + 1) + " . 1" : (root.display-mode == 1 ? Math.floor(root.ph / 4.0) + ":" + Math.floor(Math.mod(root.ph, 4.0) * 15.0) + ":" + Math.floor(Math.mod(root.ph * 60.0, 60.0)) : "00:00:00:00");
                    font-size: 15px; color: Style.lcd-text; font-family: Style.numeric-font; font-weight: 700;
                }
            }
            Rectangle { width: 1px; height: 22px; background: Style.border; }
            VerticalLayout {
                alignment: center;
                Text { text: "TEMPO"; font-size: Style.font-xxs; color: Style.text-muted; font-weight: 700; }
                Text { text: Math.floor(root.bpm * 100.0) / 100.0 + " BPM"; font-size: 13px; color: Style.lcd-text; font-family: Style.numeric-font; }
            }
            Rectangle { width: 1px; height: 22px; background: Style.border; }
            VerticalLayout {
                alignment: center;
                Text { text: "SIGNATURE"; font-size: Style.font-xxs; color: Style.text-muted; font-weight: 700; }
                Text { text: root.time-sig + " / C maj"; font-size: 12px; color: Style.lcd-text; font-family: Style.numeric-font; }
            }
            Rectangle { width: 18px; height: 24px; background: Style.panel; border-width: 1px; border-color: Style.border; border-radius: 3px;
                Text { text: "▼"; width: 100%; height: 100%; font-size: 9px; color: Style.text-dim; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.display-mode = Math.mod(root.display-mode + 1, 3); } }
            }
        }
    }
}
