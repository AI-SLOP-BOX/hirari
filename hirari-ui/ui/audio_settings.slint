import { Style } from "style.slint";
import { LineEdit } from "std-widgets.slint";
import { Z_IconButton } from "./primitives/icon_button.slint";
import { AudioSettingsActions } from "./actions/audio_settings_actions.slint";

export component Z_AudioSettings inherits Rectangle {
    in property <bool> ready: false;
    in property <string> device-catalog: "[]";
    in property <[string]> device-names: [];
    in property <[int]> device-indices: [];
    in-out property <string> device-query: "";
    in property <float> sample-rate: 0.0;
    in property <int> buffer-size: 0;
    in property <int> dropped-blocks: 0;
    in property <string> diagnostic: "";
    in property <bool> busy: false;
    background: Style.surface-1; border-width: 1px; border-color: Style.line-subtle;
    HorizontalLayout {
        padding: 18px; spacing: 18px;
        Rectangle {
            width: 196px; background: Style.surface-0; border_width: 1px; border_color: Style.border; border_radius: 8px;
            VerticalLayout {
                padding: 14px; spacing: 6px;
                Text { text: "Hirari"; font-size: 20px; color: Style.text-primary; font-weight: 700; }
                Text { text: "Settings"; font-size: 10px; color: Style.text-tertiary; }
                Rectangle { height: 16px; }
                Rectangle {
                    height: 34px; border_radius: 5px; background: Style.selection;
                    Text { text: "◖"; x: 12px; font-size: 12px; color: Style.brand; vertical-alignment: center; }
                    Text { text: "Audio"; x: 36px; font-size: 10px; color: Style.text-primary; vertical-alignment: center; }
                }
                Rectangle { vertical-stretch: 1; }
                Text { text: "Hirari DAW"; font-size: 10px; color: Style.text-tertiary; }
                Text { text: "Audio engine settings"; font-size: 9px; color: Style.text-muted; }
            }
        }
        VerticalLayout {
            spacing: 12px;
            HorizontalLayout {
                height: 44px;
                Text { text: "Audio"; font-size: 24px; color: Style.text-primary; font-weight: 700; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                LineEdit {
                    width: 220px; height: 30px;
                    text <=> root.device-query;
                    placeholder-text: "Search audio devices";
                    edited => { AudioSettingsActions.filter_devices(self.text); }
                }
                Text { text: root.ready ? "● Device connected" : "● Device offline"; font-size: 10px; color: root.ready ? Style.ok : Style.record; vertical-alignment: center; }
            }
            Text { text: "Configure the audio device, sample rate and realtime buffer used by the engine."; font-size: 10px; color: Style.text-secondary; }
            HorizontalLayout {
                spacing: 12px; vertical-stretch: 1;
                Rectangle { horizontal-stretch: 1; background: Style.surface; border_width: 1px; border_color: Style.border; border_radius: 8px; VerticalLayout { padding: 14px; spacing: 10px;
                    Text { text: "Audio device"; font-size: 15px; color: Style.text-primary; font-weight: 650; }
                    Text { text: root.dropped-blocks > 0 ? "Input drops: " + root.dropped-blocks : "Input stream stable"; font-size: 10px; color: root.dropped-blocks > 0 ? Style.record : Style.ok; }
                    Text { text: "Available devices"; font-size: 10px; color: Style.text-tertiary; }
                    for device-index in root.device-indices : Z_IconButton {
                        icon: root.device-names[device-index];
                        compact: false; enabled: !root.busy; button-width: 220px;
                        clicked => { AudioSettingsActions.select_device(device-index); }
                    }
                    if (root.device-query == "" && root.device-names.length == 0) : Text { text: "No audio devices available"; font-size: 10px; color: Style.text-muted; }
                    if (root.device-query != "" && root.device-indices.length == 0) : Text { text: "No matching audio devices"; font-size: 10px; color: Style.text-muted; }
                    Text { text: root.device-query == "" ? root.device-names.length + " audio devices" : "Showing " + root.device-indices.length + " of " + root.device-names.length + " devices"; font-size: 9px; color: Style.text-muted; }
                    Rectangle { vertical-stretch: 1; }
                    Z_IconButton { icon: "Reconnect audio"; button-width: 150px; active-col: Style.record; clicked => { AudioSettingsActions.reconnect(); } }
                } }
                Rectangle { horizontal-stretch: 1; background: Style.surface; border_width: 1px; border_color: Style.border; border_radius: 8px; VerticalLayout { padding: 14px; spacing: 10px;
                    Text { text: "Realtime performance"; font-size: 15px; color: Style.text-primary; font-weight: 650; }
                    Text { text: root.busy ? "Stop playback or recording before changing format." : "Changes apply when the transport is stopped."; font-size: 10px; color: root.busy ? Style.record : Style.text-secondary; }
                    Text { text: "Sample rate"; font-size: 10px; color: Style.text-tertiary; }
                    HorizontalLayout { spacing: 5px; for rate in ["44.1 kHz", "48 kHz", "88.2 kHz", "96 kHz", "192 kHz"] : Z_IconButton { icon: rate; compact: true; enabled: !root.busy; button-width: 76px; clicked => { AudioSettingsActions.apply_config(rate == "44.1 kHz" ? 44100 : (rate == "48 kHz" ? 48000 : (rate == "88.2 kHz" ? 88200 : (rate == "96 kHz" ? 96000 : 192000))), root.buffer-size > 0 ? root.buffer-size : 256); } } }
                    Text { text: "Buffer size"; font-size: 10px; color: Style.text-tertiary; }
                    HorizontalLayout { spacing: 4px; for size in [32, 64, 128, 256, 512, 1024, 2048] : Z_IconButton { icon: size + ""; compact: true; enabled: !root.busy; button-width: 48px; clicked => { AudioSettingsActions.apply_config(root.sample-rate > 0 ? Math.round(root.sample-rate) : 48000, size); } } Text { text: "samples"; font-size: 9px; color: Style.text-tertiary; vertical-alignment: center; } }
                    Rectangle { height: 1px; background: Style.border; }
                    Text { text: "Current  " + (root.sample-rate > 0 ? Math.round(root.sample-rate) + " Hz" : "--") + "  ·  " + (root.buffer-size > 0 ? root.buffer-size + " samples" : "--"); font-size: 11px; color: Style.brand; }
                    Text { text: root.diagnostic; font-size: 9px; color: Style.text-tertiary; overflow: elide; }
                } }
            }
        }
    }
}
