# Hirari DAW Ultimate - Professional Git Hygiene
# HONEST FIX: Privacy Guard (Ignores local paths and build artifacts)

# Build system
build/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
*.cmake
*.o
*.o.d
*.a
/bin/
/obj/

# Rust (Cargo)
target/
**/*.rs.bk
# Hirari ships applications, so Cargo.lock is intentionally versioned to keep
# developer, CI, and release dependency resolution reproducible.

# OS-specific
.DS_Store
.AppleDouble
.LSOverride
Icon
Network Trash Folder
Temporary Items
.apdisk

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Project artifacts
HirariIcon.iconset/
HirariUltimate.app/
dist/
packaging/
build-tools/
target/
/.openutau-review/
/.codex-runs/
/.tmp/
*.log
*.tmp
*.journal
*_build_output.txt
/app_output*.txt
/build_log*.txt
/hirari-core-bridge/build*.txt
/hirari-ui/*build*.txt
/hirari-ui/*errors*.txt

# Local applications, plugins, voicebanks and rendered audio
*.app/
*.clap
*.vst3/
*.component/
*.wav
*.aiff
*.flac
*.ust
*.ustx

# Personal/Config
.env
config.json
*.local
.slint-tmp/
__pycache__/
*.py[cod]

# Local audit outputs; release archives should be copied to an external
# artifact store rather than committed into the source tree.
artifacts/
release-metadata/

# Optional local vendor checkouts.  These are fetched for development or
# contract tests and must not become part of the Hirari source distribution.
third_party/
third_party_synths/
